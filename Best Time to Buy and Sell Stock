class Solution {
    /**
     * @param {number[]} prices
     * @return {number}
     */
    maxProfit(prices: number[]): number {
        //  1. I can do brutefoce -> n^2
        //  2. We could take 2 pointer var s -> first var will look for the smalles element in the array, second var looing for the highest number in the future
        //      if we encounter smaller value thant the smalles element we have. we replace it. TIme comp O(n)
        let ans : number = 0;
        let min : number = prices[0];
        let max : number = prices[0];

        for (let i = 1; i < prices.length; i++) {
            if( prices[i] < min){
                min = prices[i];
                max = prices[i];
                continue;
            }

            if( prices[i] > max ){
                ans = Math.max(ans, prices[i] - min);
                max = prices[i];
            }
        }

        return ans;
    }
}
