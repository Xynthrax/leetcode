class Solution {
    /**
     * @param {number[]} nums
     * @return {number}
     */
    maxSubArray(nums: number[]): number {

        const arr : number[] = new Array(nums.length + 1);

        arr[0] = nums[0];
        let ans : number = nums[0];

        for( let i = 1; i < nums.length ; i++ ){

            arr[i] = Math.max( nums[i] , nums[i] + arr[i-1]);
            ans = Math.max(ans, arr[i]);

        }

        return ans;
    }
}
