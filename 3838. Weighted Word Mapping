function mapWordWeights(words: string[], weights: number[]): string {

    let map = new Map<number,string>();

    for(let i = 25, j=0 ; i >=0; i--, j++){
        map.set(i, String.fromCharCode(j + 97) )
    }

    console.log(map)

    const findSumOfWord = (word: string): number => {
        let sum = 0;
        for (let i = 0; i < word.length; i++) {
            sum = (sum + weights[word.charCodeAt(i) - 97]) % 26
        }

        return sum
    }

    console.log(String.fromCharCode(findSumOfWord('abcd')))

    return words.map(word => map.get(findSumOfWord(word)).toString()).join('')

};
